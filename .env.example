# OpenAI API key for GPT models (required)
OPENAI_API_KEY=open-api-key-here

# Tavily API key for web search (required)
TAVILY_API_KEY=tavily-api-key-here

# GPT Researcher configuration
# Embedding model
EMBEDDING=openai:text-embedding-3-small
# LLM for strategic research
STRATEGIC_LLM=openai:gpt-4o-mini # To increase speed, use gpt-4o-mini

# Maximum number of research iterations
# (To increase speed, use 2)
MAX_ITERATIONS=2

# Optional example: Anthropic API key if using Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Jev relevance filter (TypeSafe) — optional overrides
# Decision model name (default: jev-latest)
# JEV_MODEL=jev-latest
# Typesafe API endpoint (default: https://api.typesafe.ai/v1)
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Max concurrent scoring requests (default: 64)
# JEV_CONCURRENCY=64
# Typesafe API key, required when Jev filtering is used
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Server configuration
LOG_LEVEL=INFO
PORT=8000 